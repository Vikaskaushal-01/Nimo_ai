# ─────────────────────────────────────────────────────────────
# Multi-AI Decision Engine — environment configuration
# Copy to `.env` and fill in values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
BACKEND_PORT=4000
# Public port of the Docker stack (frontend + /api proxy)
FRONTEND_PORT=5173

# --- AI provider (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
# If left empty, the backend falls back to a deterministic MockProvider
# so the full pipeline + UI still run end-to-end with no key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent to OpenRouter for attribution — set to your public URL when hosted
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Multi-AI Decision Engine

# Model used to synthesize the fused answer (any OpenRouter chat model)
FUSION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Model used to generate embeddings for semantic similarity + RAG
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# --- Datastores ---
# docker-compose overrides these with its internal hostnames.
MONGO_URI=mongodb://localhost:27017/multi_ai
REDIS_URL=redis://localhost:6379

# --- Auth ---
# REQUIRED in production: two different random values, 32+ chars each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10

# --- Behaviour ---
# Per-provider request timeout (ms)
AI_REQUEST_TIMEOUT_MS=120000
# Redis TTL for cached decision results (seconds)
DECISION_CACHE_TTL=3600
# Allowed browser origin(s), comma-separated. Only matters when the frontend
# calls the API cross-origin; the Docker stack is same-origin.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the backend (for real client IPs in
# rate limiting). docker-compose sets 1 (its nginx). Use 2 if your host adds
# another load balancer in front of that.
TRUST_PROXY=0

# --- Frontend (Vite) ---
# Optional. The frontend calls the API same-origin at /api/v1 (nginx in
# Docker, the Vite proxy in dev). Only set VITE_API_BASE_URL in frontend/.env
# when the API is hosted on a different domain.
